{
  "expo": {
    "name": "Clay",
    "slug": "direct",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.direct.editor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C65A35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.direct.editor"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Clay",
      "shortName": "Clay",
      "themeColor": "#C65A35",
      "backgroundColor": "#F3EEE6"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F3EEE6"
        }
      ],
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Clay saves your logos and icons to Photos.",
          "photosPermission": "Clay uses your photos in the apps you build and saves your logos and icons to Photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Clay adds your photos to the apps you build.",
          "cameraPermission": "Clay lets you take photos to use in your apps."
        }
      ]
    ],
    "scheme": "direct",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6230f06c-8647-4265-9260-3c01a4d036fd"
      }
    },
    "owner": "dorian_gulley",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6230f06c-8647-4265-9260-3c01a4d036fd"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
